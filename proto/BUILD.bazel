load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@nanopb//extra/bazel:nanopb_cc_proto_library.bzl", "cc_nanopb_proto_library")

proto_library(
    name = "sats_command_proto",
    srcs = ["sats_command.proto"],
)

cc_nanopb_proto_library(
    name = "sats_command_nanopb",
    protos = [":sats_command_proto"],
    nanopb_options_files = ["sats_command.options"],
    visibility = ["//visibility:public"],
)

proto_library(
    name = "uhf_packet_proto",
    srcs = ["uhf_packet.proto"],
    deps = [":sats_command_proto"],
)

proto_library(
    name = "sband_packet_proto",
    srcs = ["sband_packet.proto"],
)
