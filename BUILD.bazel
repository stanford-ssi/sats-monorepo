"""
Root build for all embedded software
"""

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Example Blink Target
# ============================================================================

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# ============================================================================
# Formatting
# ============================================================================

# `bazel run //:format` to rewrite, `-- --check` to verify.
sh_binary(
    name = "format",
    srcs = ["tools/format.sh"],
)

cc_library(
    name = "common_lib",
    deps = [
        "//common/cobs",
        "//common/util",
        "//common/cmd_receiver",
        "//common/cmd_responder",
        "//common/slate",
        "//common/rust_example",
        "//common/fs",
    ]
)

cc_library(
    name = "blink_lib",
    hdrs = [
        "flight/blink/src/slate.hpp",
    ],
    includes = ["flight/blink/src"],
    deps = [
        ":common_lib",
        "//hal:pico_hal",
        "//proto:sats_command_nanopb",
    ]
)

cc_binary(
    name = "blink",
    srcs = ["flight/blink/src/main.cpp"],
    includes = ["flight/blink/src"],
    copts = [
         "-Wall",
        "-Wextra",
        "-Werror",
        "-Wshadow",
        "-Wdouble-promotion",
        "-DCFG_TUD_CDC=2",
    ],
    deps = [":blink_lib"],
)

