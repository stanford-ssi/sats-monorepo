"""
Module definition for Stanford Student Space Initiative's Monorepo
"""

module(
    name = "sats_monorepo",
    version = "0.0.1",
)

bazel_dep(name = "rules_rust", version = "0.54.1")  # check for latest

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["thumbv8m.main-none-eabi"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Platform definitions for cross-compilation
bazel_dep(name = "platforms", version = "0.0.11")

# Platform definitions for cross-compilation
bazel_dep(name = "rules_cc", version = "0.2.17")

# Pico SDK with native Bazel support from Bazel Central Registry
bazel_dep(name = "pico-sdk", version = "2.2.0")

# Protobuf and nanopb
bazel_dep(name = "nanopb", version = "0.4.9.1.bcr.2")
bazel_dep(name = "protobuf", version = "36.1.bcr.1")
bazel_dep(name = "rules_proto", version = "7.1.0")

# Register pico-sdk toolchains for macOS (both Intel and Apple Silicon)
register_toolchains(
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2350",
)

# Google Test Framework
bazel_dep(name = "googletest", version = "1.17.0")

# littlefs, the filesystem the flash driver in hal/ is wired up to. Not in
# the bazel central registry, so it is fetched from its release tarball and
# built with the build file in third_party/.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "littlefs",
    build_file = "//third_party:littlefs.BUILD",
    sha256 = "15521be8aaed133c453e7337714e029a9f62480ab41f59c4ba5d18297a076207",
    strip_prefix = "littlefs-2.11.3",
    urls = ["https://github.com/littlefs-project/littlefs/archive/refs/tags/v2.11.3.tar.gz"],
)
