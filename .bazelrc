# ============================================================================
# Common Settings
# ============================================================================

# Set C/C++ language standards
build --cxxopt=-std=gnu++2a
build --conlyopt=-std=gnu2x

# Show detailed build information
build --verbose_failures
build --announce_rc

# Enable color output
common --color=yes

# Cache build results
build --disk_cache=~/.cache/bazel

# .bazelrc
build --noincompatible_disallow_ctx_resolve_tools

# ============================================================================
# Build Profile Configurations
# ============================================================================

# Raspberry Pi Pico Development Profile (RP2350)
build:pico --define=profile=pico
build:pico --platforms=//platforms:arm_cortex_m33_platform
build:pico --define=PICO_BOARD=samwise_pico
build:pico --define=PICO_PLATFORM=rp2350
build:pico --define=MRAM=1
build:pico --copt=-DMRAM=1
build:pico --copt=-DPICO_CRT0_IMAGE_TYPE_TBYB=0
build:pico --copt=-DPICO=1
build:pico --compilation_mode=dbg
build:pico --copt=-Og
build:pico --copt=-g
build:pico --@pico-sdk//bazel/config:PICO_STDIO_USB=True
build:pico --aspects=@pico-sdk//tools:uf2_aspect.bzl%pico_uf2_aspect #,//bzl:bin_aspect.bzl%pico_bin_aspect
build:pico --output_groups=+pico_uf2_files,+pico_bin_files

# ============================================================================
# Optimization Settings
# ============================================================================

# Debug build settings
build:dbg --compilation_mode=dbg
build:dbg --copt=-Og
build:dbg --copt=-g

# Release build settings
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-DNDEBUG

# Size-optimized build settings
build:size --compilation_mode=opt
build:size --copt=-Os
build:size --copt=-DNDEBUG
