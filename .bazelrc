# Platform selection
build:rp2350 --platforms=@pico-sdk//bazel/platform:rp2350

# UF2 generation
build:uf2 --aspects=@pico-sdk//tools:uf2_aspect.bzl%pico_uf2_aspect
build:uf2 --output_groups=+pico_uf2_files

# Debug
build:debug --compilation_mode=dbg
build:debug --strip=never

build --noincompatible_disallow_ctx_resolve_tools
