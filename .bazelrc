# ============================================================================
# Common Settings
# ============================================================================

# Set C/C++ language standards
build --cxxopt=-std=gnu++2a
build --conlyopt=-std=gnu2x

# Show detailed build information
build --verbose_failures
build --announce_rc

# Enable color output
common --color=yes

# Cache build results
build --disk_cache=~/.cache/bazel

# .bazelrc
build --noincompatible_disallow_ctx_resolve_tools

# ============================================================================
# Build Profile Configurations
# ============================================================================

# Chips and boards are bazel platforms, see //platforms/chips and
# //platforms/boards. A board config picks its platform (which carries the
# chip and board flags) plus the chip's output handling below.

# Internal rp2350 output handling, pulled in by board configs. Using it on
# its own sets no board, so firmware targets are rejected as incompatible.
build:_rp2350 --aspects=@pico-sdk//tools:uf2_aspect.bzl%pico_uf2_aspect
build:_rp2350 --output_groups=+pico_uf2_files
# satui reads slate offsets from the elf's DWARF, so keep debug info.
build:_rp2350 --compilation_mode=dbg
build:_rp2350 --copt=-Og

# Raspberry Pi Pico 2 dev board
build:pico --config=_rp2350
build:pico --platforms=//platforms/boards:pico

# PiCubed flight board
build:picubed --config=_rp2350
build:picubed --platforms=//platforms/boards:picubed

# ============================================================================
# Optimization Settings
# ============================================================================

# Debug build settings
build:dbg --compilation_mode=dbg
build:dbg --copt=-Og
build:dbg --copt=-g

# Release build settings
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-DNDEBUG

# Size-optimized build settings
build:size --compilation_mode=opt
build:size --copt=-Os
build:size --copt=-DNDEBUG
